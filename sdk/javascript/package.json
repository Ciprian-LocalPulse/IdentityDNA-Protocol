    "demo": "tsx src/demo/demoHttpClient.ts",
    "fixtures": "tsx src/interop/printFixtures.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "ISC"
}
